<style>
:root{--bg:#f4f6f8;--card:#fff;--text:#263238;--muted:#66747b;--line:#d7dde1;--accent:#2b6f9e;--accent-soft:#e6f1f8}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}button,a,summary{font:inherit}button{cursor:pointer}.app{width:min(1080px,100%);margin:auto;padding:10px}.topbar{display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:10px}.home-btn,.btn{min-height:44px;border:1px solid var(--line);border-radius:12px;background:#fff;color:var(--text);font-weight:800;padding:9px 14px;text-decoration:none}.btn.primary{background:var(--accent);color:#fff;border-color:var(--accent)}.title-row{display:flex;justify-content:space-between;align-items:end;gap:12px;flex-wrap:wrap}h1{font-size:22px;margin:0 0 3px}.sub{font-size:13px;color:var(--muted)}.map-meta{display:flex;gap:14px;font-weight:800;font-size:14px;white-space:nowrap}.map-shell{margin-top:8px;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:#e8ecee;box-shadow:0 1px 2px rgba(0,0,0,.05)}#map{display:block;width:100%;height:auto;aspect-ratio:7/5;touch-action:none;user-select:none;-webkit-user-select:none}.map-controls{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;margin-top:8px}.guide{font-size:12px;color:var(--muted);line-height:1.5}.zoom-group{display:flex;gap:5px}.zoom-group button{min-width:44px;min-height:44px;border:1px solid var(--line);background:#fff;border-radius:10px;font-weight:900}.main-grid{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:12px;margin-top:12px}.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:14px}.card-head{display:flex;justify-content:space-between;align-items:center;gap:8px}.hints{margin-top:10px;display:grid;gap:10px}.hint{padding-left:10px;border-left:3px solid #b8c1c6;font-size:14px;line-height:1.6}.hint.distance{border-left-color:#8b6b13}.full{width:100%;margin-top:12px}.score{font-size:28px;font-weight:900}.message{margin-top:8px;min-height:42px;font-size:14px;line-height:1.5}details summary{min-height:44px;padding:10px 0;font-weight:800;cursor:pointer}#legend{width:100%;height:auto}dialog{color:var(--text);border:0;padding:0;border-radius:18px;box-shadow:0 20px 70px rgba(0,0,0,.35)}dialog::backdrop{background:rgba(0,0,0,.48)}.confirm-dialog{width:min(360px,90vw)}.dialog-inner{padding:20px}.dialog-title{font-size:20px;font-weight:900}.dialog-text{font-size:14px;color:var(--muted);line-height:1.6;margin-top:7px}.dialog-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:16px}.dialog-actions button{min-height:48px;border-radius:12px;font-weight:900;border:1px solid var(--line)}.dialog-actions .ok{background:var(--accent);color:white;border-color:var(--accent)}
.treasure-dialog{width:min(420px,92vw);overflow:visible;background:transparent;box-shadow:none}.treasure-dialog::backdrop{background:rgba(0,0,0,.68);backdrop-filter:blur(2px)}.treasure-result{overflow:hidden;border-radius:24px;padding:20px 18px 18px;text-align:center;background:radial-gradient(circle at 50% 37%,#fffbd2 0,#ffe984 32%,#f6bd3d 67%,#c87913 100%);box-shadow:0 20px 70px rgba(0,0,0,.42),inset 0 0 35px rgba(255,255,255,.45)}.treasure-title{font-size:29px;font-weight:1000;color:#6b3700;text-shadow:0 2px rgba(255,255,255,.6)}.treasure-scene{position:relative;height:235px;margin-top:2px}.chest{position:absolute;left:50%;bottom:20px;width:190px;height:150px;transform:translateX(-50%)}.chest-body{position:absolute;z-index:5;left:12px;bottom:0;width:166px;height:87px;overflow:hidden;border:5px solid #64320e;border-radius:6px 6px 17px 17px;background:linear-gradient(90deg,#71320e 0 8%,#c46b20 8% 44%,#88400f 44% 52%,#c87324 52% 92%,#6c2f0d 92%);box-shadow:inset 0 -13px rgba(70,26,3,.18)}.chest-body:after{content:"";position:absolute;left:0;right:0;top:31px;height:11px;background:#d6a131;border-block:2px solid #7a510c}.chest-lid-closed{position:absolute;z-index:8;left:12px;bottom:80px;width:166px;height:62px;transform-origin:50% 100%;border:5px solid #64320e;border-radius:75px 75px 7px 7px;background:linear-gradient(90deg,#71320e 0 8%,#c46b20 8% 44%,#88400f 44% 52%,#c87324 52% 92%,#6c2f0d 92%);box-shadow:0 3px 2px rgba(0,0,0,.12)}.lid-band{position:absolute;left:72px;top:0;width:20px;height:100%;background:#dda935;border-inline:2px solid #76510d}.chest-lid-open{position:absolute;z-index:3;left:16px;bottom:76px;width:158px;height:88px;opacity:0;transform-origin:50% 100%;transform:translateY(35px) scaleY(.18);border:6px solid #63320f;border-radius:68px 68px 11px 11px;background:linear-gradient(180deg,#754019 0,#8d4c1d 54%,#60300f 100%);box-shadow:inset 0 0 0 5px #b66b28,inset 0 0 0 8px #5f2d0d,0 5px 7px rgba(0,0,0,.22)}.chest-lid-open:before{content:"";position:absolute;left:16px;right:16px;top:16px;bottom:12px;border:3px solid #4e260c;border-radius:48px 48px 8px 8px;background:radial-gradient(ellipse at 50% 35%,#9d5825 0,#774019 68%,#5d2c0e 100%)}.lid-inner-band{position:absolute;z-index:2;left:68px;top:8px;width:16px;height:72px;background:#b57e28;border-inline:2px solid #6f470d;opacity:.8}.chest-lock{position:absolute;z-index:5;left:66px;top:17px;width:33px;height:34px;border:3px solid #79530d;border-radius:6px;background:#efc23e}.inside-loot{position:absolute;z-index:3;left:10px;right:10px;top:-8px;opacity:0;transform:translateY(15px);font-size:25px;font-weight:1000;color:#ffd52e;text-shadow:0 1px #754700}.loot{position:absolute;z-index:6;left:50%;top:123px}.coin,.gem{position:absolute;opacity:0;font-size:27px;font-weight:1000}.coin{color:#ffd32a;text-shadow:0 1px #754700}.gem{color:#1ba7e2;text-shadow:0 1px #075679}.spark{position:absolute;z-index:10;opacity:0;font-size:30px;color:#fffdeb;text-shadow:0 0 8px #fff,0 0 17px #ffd633}.s1{left:17%;top:48px}.s2{right:18%;top:62px}.s3{left:35%;top:12px}.s4{right:34%;top:27px}.treasure-scene.play .chest-lid-closed{animation:closedLidAway .62s .12s ease-in-out forwards}.treasure-scene.play .chest-lid-open{animation:openLidBack .72s .14s cubic-bezier(.2,.78,.25,1) forwards}.treasure-scene.play .inside-loot{animation:revealLoot .28s .55s ease-out forwards}.treasure-scene.play .c1{animation:loot1 .90s .68s ease-out forwards}.treasure-scene.play .c2{animation:loot2 .95s .74s ease-out forwards}.treasure-scene.play .g1{animation:loot3 .90s .78s ease-out forwards}.treasure-scene.play .g2{animation:loot4 .95s .83s ease-out forwards}.treasure-scene.play .spark{animation:sparkle .8s 1.00s ease-out forwards}.treasure-scene.play .s2{animation-delay:1.10s}.treasure-scene.play .s3{animation-delay:1.18s}.treasure-scene.play .s4{animation-delay:1.26s}@keyframes closedLidAway{0%{opacity:1;transform:translateY(0) scaleY(1)}38%{opacity:1;transform:translateY(-10px) scaleY(.72)}74%{opacity:.55;transform:translateY(-22px) scaleY(.30)}100%{opacity:0;transform:translateY(-26px) scaleY(.12)}}@keyframes openLidBack{0%{opacity:0;transform:translateY(35px) scaleY(.18)}35%{opacity:.35;transform:translateY(18px) scaleY(.46)}68%{opacity:1;transform:translateY(3px) scaleY(.88)}100%{opacity:1;transform:translateY(-3px) scaleY(1)}}@keyframes revealLoot{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}@keyframes loot1{0%{opacity:0;transform:translate(0,26px) scale(.4)}28%{opacity:1}100%{opacity:1;transform:translate(-66px,-69px) rotate(-25deg)}}@keyframes loot2{0%{opacity:0;transform:translate(0,26px) scale(.4)}28%{opacity:1}100%{opacity:1;transform:translate(53px,-79px) rotate(35deg)}}@keyframes loot3{0%{opacity:0;transform:translate(0,24px) scale(.4)}28%{opacity:1}100%{opacity:1;transform:translate(-28px,-104px) rotate(24deg)}}@keyframes loot4{0%{opacity:0;transform:translate(0,24px) scale(.4)}28%{opacity:1}100%{opacity:1;transform:translate(76px,-47px) rotate(-34deg)}}@keyframes sparkle{0%{opacity:0;transform:scale(.2) rotate(0)}45%{opacity:1;transform:scale(1.45) rotate(80deg)}100%{opacity:0;transform:scale(.5) rotate(150deg)}}.treasure-score{display:flex;justify-content:center;align-items:baseline;gap:8px;margin:-2px 0 14px;color:#653300;font-weight:900}.treasure-score strong{font-size:36px}.treasure-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.treasure-actions button{min-height:48px;border-radius:12px;font-weight:900}.treasure-actions .back{border:1px solid rgba(94,48,0,.25);background:#fff9df;color:#5d3300}.treasure-actions .next{border:1px solid #673700;background:#713f0b;color:#fff}
@media(max-width:720px){.app{padding:8px}.main-grid{grid-template-columns:1fr}h1{font-size:20px}.map-shell{border-radius:10px}.card{padding:12px}.title-row{align-items:start}}@media(max-width:440px){.map-meta{font-size:12px;gap:9px}.guide{max-width:235px}.treasure-title{font-size:26px}}@media(prefers-reduced-motion:reduce){.treasure-scene.play .chest-lid-closed{animation:none;opacity:0}.treasure-scene.play .chest-lid-open{animation:none;opacity:1;transform:translateY(-3px) scaleY(1)}.treasure-scene.play .inside-loot,.treasure-scene.play .coin,.treasure-scene.play .gem{animation:none;opacity:1}.treasure-scene.play .spark{display:none}}
.treasure-dialog{max-height:calc(100dvh - 16px);overflow-y:auto}.dekitas-pr{width:min(100%,326px);margin:20px auto 0;padding:10px 8px 0;border-top:1px solid #b7aa88;text-align:center;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}.dekitas-pr-head{display:flex;justify-content:center;align-items:center;gap:8px;margin-bottom:4px;font-size:12px;font-weight:800}.dekitas-pr-label{padding:2px 7px;border:1px solid currentColor;border-radius:999px;font-size:10px}.dekitas-pr-copy{margin:0 0 8px;font-size:13px;line-height:1.45}.dekitas-pr a{display:block;line-height:0}.dekitas-pr-banner{display:block;width:100%;max-width:300px;height:auto;margin:auto}
</style>
</head>
<body>
<div class="app">
  <div class="topbar"><a href="/" class="home-btn">← ガクハコ</a><button id="newGame" class="btn">新しい地図</button></div>
  <div class="title-row"><div><h1>地図で宝さがし</h1><div class="sub">ヒントを手がかりに、宝がある100m四方を見つけよう</div></div><div class="map-meta"><span>↑ 北</span><span>1マス＝100m</span></div></div>
  <div class="map-shell"><svg id="map" viewBox="0 0 700 500" aria-label="架空の地図"></svg></div>
  <div class="map-controls"><div class="guide"><b>操作：</b>ピンチで拡大・縮小／拡大中はドラッグで移動／答える場所を長押し</div><div class="zoom-group"><button id="zoomOut" aria-label="縮小">−</button><button id="zoomReset">全体</button><button id="zoomIn" aria-label="拡大">＋</button></div></div>
  <div class="main-grid">
    <section class="card"><div class="card-head"><b>ヒント</b><span id="hintCount" class="sub"></span></div><div id="hints" class="hints"></div><button id="nextHint" class="btn full">次のヒントを見る</button></section>
    <div style="display:grid;gap:12px"><section class="card"><div class="card-head"><b>得点</b><span id="score" class="score">1000</span></div><div id="msg" class="message"></div></section><details class="card"><summary>地図記号を見る</summary><div class="sub">分からない記号があったときだけ開けます。</div><svg id="legend" viewBox="0 0 270 225"></svg></details></div>
  </div>
</div>
<dialog id="answerDialog" class="confirm-dialog"><div class="dialog-inner"><div class="dialog-title">この場所でいいですか？</div><div class="dialog-text">青く囲まれた100m四方を答えにします。</div><div class="dialog-actions"><button id="cancelAnswer">やめる</button><button id="confirmAnswer" class="ok">ここにする</button></div></div></dialog>
<dialog id="treasureDialog" class="treasure-dialog"><div class="treasure-result"><div class="treasure-title">🎉 宝を発見！</div><div id="treasureScene" class="treasure-scene" aria-hidden="true"><span class="spark s1">✦</span><span class="spark s2">✧</span><span class="spark s3">✦</span><span class="spark s4">✧</span><div class="loot"><span class="coin c1">●</span><span class="coin c2">●</span><span class="gem g1">◆</span><span class="gem g2">♦</span></div><div class="chest"><div class="chest-lid-open"><div class="lid-inner-band"></div></div><div class="chest-lid-closed"><div class="lid-band"></div></div><div class="chest-body"><div class="inside-loot">● ◆ ● ♦ ●</div><div class="chest-lock"></div></div></div></div><div class="treasure-score"><span>得点</span><strong id="treasureScore">1000</strong><span>点</span></div><div class="treasure-actions"><button id="backToMap" class="back">地図を見る</button><button id="nextTreasure" class="next">次の地図</button></div><aside class="dekitas-pr" aria-label="保護者向けPR"><div class="dekitas-pr-head"><span>保護者の方へ</span><span class="dekitas-pr-label">PR</span></div><p class="dekitas-pr-copy">小中学生向け通信教育<br>「デキタス」</p><a href="https://px.a8.net/svt/ejp?a8mat=4BC0UC+1GZLMA+2MJW+I2PXD" rel="nofollow"><img class="dekitas-pr-banner" border="0" width="300" height="250" alt="" src="https://www24.a8.net/svt/bgt?aid=260901444089&wid=001&eno=01&mid=s00000012254003036000&mc=1"></a><img border="0" width="1" height="1" src="https://www14.a8.net/0.gif?a8mat=4BC0UC+1GZLMA+2MJW+I2PXD" alt=""></aside></div></dialog>
<script>
(()=>{
const $=s=>document.querySelector(s),map=$('#map'),legend=$('#legend'),hintsEl=$('#hints'),nextBtn=$('#nextHint'),newBtn=$('#newGame'),scoreEl=$('#score'),msg=$('#msg'),hintCount=$('#hintCount'),answerDialog=$('#answerDialog'),treasureDialog=$('#treasureDialog'),treasureScene=$('#treasureScene'),treasureScore=$('#treasureScore'),confirmBtn=$('#confirmAnswer'),cancelBtn=$('#cancelAnswer'),backBtn=$('#backToMap'),nextTreasureBtn=$('#nextTreasure'),zoomInBtn=$('#zoomIn'),zoomOutBtn=$('#zoomOut'),zoomResetBtn=$('#zoomReset');
const COLS=14,ROWS=10,CELL=50,W=700,H=500,ALL=Array.from({length:COLS*ROWS},(_,i)=>({c:i%COLS,r:Math.floor(i/COLS)})),FAC=[['school','小・中学校'],['post','郵便局'],['hospital','病院'],['shrine','神社'],['temple','寺院']],LAND=[['rice','田'],['field','畑'],['orchard','果樹園'],['broad','広葉樹林'],['conifer','針葉樹林']];
let S=null,selectedCell=null,camera={scale:1,tx:0,ty:0},pointers=new Map(),gesture=null,holdTimer=null,holdLast=null;
const ri=(a,b)=>a+Math.floor(Math.random()*(b-a+1)),pick=a=>a[Math.floor(Math.random()*a.length)],key=p=>p.r*COLS+p.c,eq=(a,b)=>a&&b&&a.c===b.c&&a.r===b.r,center=p=>({x:p.c*CELL+25,y:p.r*CELL+25}),rectOf=p=>({left:p.c*CELL,right:(p.c+1)*CELL,top:p.r*CELL,bottom:(p.r+1)*CELL}),inside=(p,z)=>p.c>=z.c&&p.c<z.c+z.w&&p.r>=z.r&&p.r<z.r+z.h,clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
function circleTouchesCell(cell,o,radius){const a=rectOf(cell),x=clamp(o.x,a.left,a.right),y=clamp(o.y,a.top,a.bottom),dx=x-o.x,dy=y-o.y;return dx*dx+dy*dy<=radius*radius+.001}
function sym(t,x,y,s=.56){const B='#24201f',G='#707070',BL='#275fc2',T=`translate(${x} ${y}) scale(${s})`;if(t==='school')return `<g transform="${T}" stroke="${B}" fill="none" stroke-width="6"><path d="M0-16V-9M-13-8H13M-10-5L10 13M10-5L-10 13"/></g>`;if(t==='post')return `<g transform="${T}" stroke="${B}" fill="none" stroke-width="4"><circle r="15"/><path d="M-11-7H11M-11-1H11M0-1V13"/></g>`;if(t==='hospital')return `<g transform="${T}" stroke="${B}" fill="none" stroke-width="3.3"><path d="M-13-12H13V7L0 16L-13 7Z"/><path d="M0-8V9M-8 0H8" stroke-width="4.5"/></g>`;if(t==='shrine')return `<g transform="${T}" stroke="${B}" fill="none" stroke-width="5"><path d="M-15-12H15M-11-5H11M-10-12V15M10-12V15"/></g>`;if(t==='temple')return `<g transform="${T}" stroke="${B}" fill="none" stroke-width="5"><path d="M-14-10H2V2H14V-14M14 10H-2V-2H-14V14"/></g>`;if(t==='rice')return `<g transform="${T}" stroke="${BL}" stroke-width="3"><path d="M-5-11V11M5-11V11"/></g>`;if(t==='field')return `<g transform="${T}" stroke="${G}" fill="none" stroke-width="3.4"><path d="M-10-6L0 4L10-6"/></g>`;if(t==='orchard')return `<g transform="${T}" stroke="${G}" fill="none" stroke-width="3"><path d="M0-14V-7"/><circle cy="2" r="8"/></g>`;if(t==='broad')return `<g transform="${T}" stroke="${G}" fill="none" stroke-width="3"><circle cx="-2" cy="-1" r="8"/><path d="M3 5H13"/></g>`;if(t==='conifer')return `<g transform="${T}" stroke="${G}" fill="none" stroke-width="3.4"><path d="M-9 12L0-15L9 12H16"/></g>`;return''}
function drawLegend(){let z='';[...FAC,...LAND].forEach((a,i)=>{const c=i%2,r=Math.floor(i/2),x=26+c*135,y=22+r*40;z+=sym(a[0],x,y,.54)+`<text x="${x+22}" y="${y+5}" font-size="12" fill="#222">${a[1]}</text>`});legend.innerHTML=z}
function makeMap(){const land={field:{c:1,r:1,w:3,h:2},rice:{c:9,r:1,w:3,h:2},broad:{c:1,r:6,w:3,h:2},conifer:{c:5,r:6,w:2,h:2},orchard:{c:10,r:6,w:3,h:2}},roadRow=ri(3,4),railRow=ri(7,8),riverCol=ri(5,8),roadY=roadRow*CELL+25,railY=railRow*CELL+25,riverBase=riverCol*CELL+25,phase=Math.random()*6,riverX=y=>riverBase+Math.sin(y/115+phase)*8,used=new Set(),P={};for(const f of FAC){let p,g=0;do{p={c:ri(1,12),r:ri(1,8)};g++}while((used.has(key(p))||Object.values(land).some(z=>inside(p,z))||p.r===roadRow||p.r===railRow||p.c===riverCol)&&g<500);P[f[0]]=p;used.add(key(p))}return{land,roadRow,railRow,riverCol,roadY,railY,riverX,P}}
function add(pool,target,text,type,test,meta={}){if(!test(target))return;const n=ALL.filter(test).length;if(n<=0||n>=ALL.length)return;pool.push({text,type,test,n,...meta})}
function buildPool(p,target){const pool=[];for(const f of FAC){const origin=center(p.P[f[0]]);for(const meters of [200,300,400]){const radius=meters/2;add(pool,target,`宝は${f[1]}から${meters}m以内です。`,'distance',c=>circleTouchesCell(c,origin,radius),{origin,radius,meters})}}for(const f of FAC.filter(x=>['school','post','shrine','temple'].includes(x[0]))){const q=p.P[f[0]];add(pool,target,`宝は${f[1]}より北にあります。`,'direction',c=>c.r<q.r);add(pool,target,`宝は${f[1]}より南にあります。`,'direction',c=>c.r>q.r);add(pool,target,`宝は${f[1]}より東にあります。`,'direction',c=>c.c>q.c);add(pool,target,`宝は${f[1]}より西にあります。`,'direction',c=>c.c<q.c)}for(const l of LAND)add(pool,target,`宝は${l[1]}の中にあります。`,'land',c=>inside(c,p.land[l[0]]));add(pool,target,'宝は田・畑・果樹園のいずれかにあります。','land',c=>inside(c,p.land.rice)||inside(c,p.land.field)||inside(c,p.land.orchard));add(pool,target,'宝は森林の中にあります。','land',c=>inside(c,p.land.broad)||inside(c,p.land.conifer));add(pool,target,'宝は川の東側にあります。','terrain',c=>c.c>p.riverCol);add(pool,target,'宝は川の西側にあります。','terrain',c=>c.c<p.riverCol);add(pool,target,'宝は黄色い主要道路より北側にあります。','terrain',c=>c.r<p.roadRow);add(pool,target,'宝は黄色い主要道路より南側にあります。','terrain',c=>c.r>p.roadRow);add(pool,target,'宝は鉄道より北側にあります。','terrain',c=>c.r<p.railRow);add(pool,target,'宝は鉄道より南側にあります。','terrain',c=>c.r>p.railRow);return pool}
function chooseHints(target,pool){const firsts=pool.filter(h=>h.type==='distance'&&h.n>=10&&h.n<=70).sort(()=>Math.random()-.5);for(const first of firsts){let chosen=[first],remain=ALL.filter(first.test),dirs=0,counts=[remain.length];function dfs(){if(remain.length===1&&eq(remain[0],target)){const types=new Set(chosen.map(h=>h.type)),other=chosen.filter(h=>!['distance','direction'].includes(h.type)).length;if(chosen.length>=3&&chosen.length<=5&&types.size>=3&&other>=1)return{hints:[...chosen],counts:[...counts]}}if(chosen.length>=5)return null;const opts=[];for(const h of pool){if(chosen.includes(h)||h.type==='distance'||(h.type==='direction'&&dirs>=2))continue;const next=remain.filter(h.test);if(!next.length||next.length===remain.length)continue;if(remain.length>=8&&next.length>Math.floor(remain.length*.70))continue;const wanted=Math.max(1,Math.round(remain.length*.45));opts.push({h,next,score:Math.abs(next.length-wanted)+(chosen.some(x=>x.type===h.type)?8:0)})}opts.sort((a,b)=>a.score-b.score);for(const o of opts.slice(0,20)){const old=remain,oldDirs=dirs;chosen.push(o.h);remain=o.next;if(o.h.type==='direction')dirs++;counts.push(remain.length);const found=dfs();if(found)return found;counts.pop();chosen.pop();remain=old;dirs=oldDirs}return null}const found=dfs();if(found)return found}return null}
function makeBuildings(p){const arr=[],zones=[{x:15,y:245,w:190,h:210},{x:220,y:235,w:120,h:120},{x:390,y:25,w:115,h:120},{x:525,y:165,w:155,h:275}];for(const z of zones)for(let y=z.y;y<z.y+z.h;y+=24)for(let x=z.x;x<z.x+z.w;x+=26){if(Math.random()<.3)continue;const cell={c:Math.floor((x+10)/CELL),r:Math.floor((y+8)/CELL)};if(Object.values(p.land).some(a=>inside(cell,a))||cell.r===p.roadRow||cell.r===p.railRow||cell.c===p.riverCol)continue;arr.push({x:x+ri(1,5),y:y+ri(1,5),w:ri(10,18),h:ri(7,13)})}return arr}
function generate(){for(let i=0;i<3500;i++){const p=makeMap(),landCells=ALL.filter(c=>Object.values(p.land).some(z=>inside(c,z))),target=Math.random()<.55?pick(landCells):pick(ALL),pool=buildPool(p,target),sol=chooseHints(target,pool);if(!sol)continue;const final=ALL.filter(c=>sol.hints.every(h=>h.test(c)));if(final.length!==1||!eq(final[0],target))continue;let prev=ALL.length,ok=true;for(const n of sol.counts){if(n>=prev){ok=false;break}prev=n}if(!ok||prev!==1)continue;return{...p,target,hints:sol.hints,counts:sol.counts,shown:1,score:1000,wrong:new Set(),done:false,buildings:makeBuildings(p)}}return null}
function drawLand(z,t){let s='';for(let r=z.r;r<z.r+z.h;r++)for(let c=z.c;c<z.c+z.w;c++){const p=center({c,r});s+=sym(t,p.x,p.y,.53)}return s}function minorRoad(x1,y1,x2,y2){return `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#aaa" stroke-width="3"/><line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#f8f8f6" stroke-width="1.4"/>`}function riverPath(p){const a=[];for(let y=0;y<=500;y+=8)a.push(`${p.riverX(y)},${y}`);return'M'+a.join(' L')}
function drawWorld(){let z='<rect width="700" height="500" fill="#f7f7f4"/>';for(const b of S.buildings)z+=`<rect x="${b.x}" y="${b.y}" width="${b.w}" height="${b.h}" fill="#f2c09c" stroke="#db9569" stroke-width=".65"/>`;z+=minorRoad(40,250,205,250)+minorRoad(80,230,80,470)+minorRoad(145,235,145,470)+minorRoad(235,250,335,250)+minorRoad(285,235,285,350)+minorRoad(390,85,505,85)+minorRoad(420,35,420,145)+minorRoad(560,165,560,460)+minorRoad(625,165,625,460)+minorRoad(520,275,690,275)+minorRoad(520,345,690,345);for(const l of LAND)z+=drawLand(S.land[l[0]],l[0]);z+=`<line x1="0" y1="${S.roadY}" x2="700" y2="${S.roadY}" stroke="#c2a500" stroke-width="13"/><line x1="0" y1="${S.roadY}" x2="700" y2="${S.roadY}" stroke="#f4dc3c" stroke-width="8"/>`;const rp=riverPath(S);z+=`<path d="${rp}" fill="none" stroke="#b9ddeb" stroke-width="18"/><path d="${rp}" fill="none" stroke="#347fa2" stroke-width="2.2"/><line x1="0" y1="${S.railY}" x2="700" y2="${S.railY}" stroke="#333" stroke-width="2.3"/>`;for(let x=6;x<700;x+=14)z+=`<line x1="${x}" y1="${S.railY-5}" x2="${x}" y2="${S.railY+5}" stroke="#333" stroke-width="1.3"/>`;z+='<g stroke="#777" stroke-width="1" opacity=".22">';for(let x=0;x<=700;x+=50)z+=`<line x1="${x}" y1="0" x2="${x}" y2="500"/>`;for(let y=0;y<=500;y+=50)z+=`<line x1="0" y1="${y}" x2="700" y2="${y}"/>`;z+='</g>';for(const h of S.hints.slice(0,S.shown))if(h.type==='distance')z+=`<circle cx="${h.origin.x}" cy="${h.origin.y}" r="${h.radius}" fill="#c6aa3b" fill-opacity=".035" stroke="#806816" stroke-width="2.2" stroke-dasharray="8 6"/>`;for(const f of FAC){const p=center(S.P[f[0]]);z+=`<circle cx="${p.x}" cy="${p.y}" r="15" fill="#f7f7f4" fill-opacity=".96"/>${sym(f[0],p.x,p.y,.54)}`}for(const q of S.wrong){const r=Math.floor(q/COLS),c=q%COLS,p=center({c,r});z+=`<path d="M${p.x-9} ${p.y-9}L${p.x+9} ${p.y+9}M${p.x+9} ${p.y-9}L${p.x-9} ${p.y+9}" stroke="#9a3030" stroke-width="3"/>`}if(selectedCell&&!S.done){const r=rectOf(selectedCell);z+=`<rect x="${r.left+2}" y="${r.top+2}" width="46" height="46" fill="#dcecff" fill-opacity=".58" stroke="#1e6bb8" stroke-width="3"/>`}if(S.done){const r=rectOf(S.target),p=center(S.target);z+=`<rect x="${r.left+2}" y="${r.top+2}" width="46" height="46" fill="#fff0a3" fill-opacity=".75" stroke="#806816" stroke-width="3"/><text x="${p.x}" y="${p.y+9}" text-anchor="middle" font-size="28">💎</text>`}return z}
function clampCamera(){camera.scale=clamp(camera.scale,1,3.5);camera.tx=clamp(camera.tx,W-W*camera.scale,0);camera.ty=clamp(camera.ty,H-H*camera.scale,0)}function applyCamera(){clampCamera();const g=map.querySelector('#world');if(g)g.setAttribute('transform',`translate(${camera.tx} ${camera.ty}) scale(${camera.scale})`)}function render(){if(!S)return;map.innerHTML=`<rect width="${W}" height="${H}" fill="#e9edef"/><g id="world" transform="translate(${camera.tx} ${camera.ty}) scale(${camera.scale})">${drawWorld()}</g>`;hintsEl.innerHTML='';S.hints.slice(0,S.shown).forEach((h,i)=>{const d=document.createElement('div');d.className='hint'+(h.type==='distance'?' distance':'');d.innerHTML=`<b>ヒント${i+1}</b><br>${h.text}`;hintsEl.appendChild(d)});hintCount.textContent=`${S.shown}/${S.hints.length}`;scoreEl.textContent=S.score;nextBtn.disabled=S.done||S.shown>=S.hints.length;nextBtn.textContent=S.shown>=S.hints.length?'ヒントは全部出ました':'次のヒントを見る'}
function svgPoint(clientX,clientY){const p=map.createSVGPoint();p.x=clientX;p.y=clientY;return p.matrixTransform(map.getScreenCTM().inverse())}function worldPoint(clientX,clientY){const p=svgPoint(clientX,clientY);return{x:(p.x-camera.tx)/camera.scale,y:(p.y-camera.ty)/camera.scale}}function zoomAt(factor,anchor={x:W/2,y:H/2}){const old=camera.scale,newScale=clamp(old*factor,1,3.5),wx=(anchor.x-camera.tx)/old,wy=(anchor.y-camera.ty)/old;camera.scale=newScale;camera.tx=anchor.x-wx*newScale;camera.ty=anchor.y-wy*newScale;applyCamera()}function clearHold(){if(holdTimer){clearTimeout(holdTimer);holdTimer=null}}
function openSelectionAt(clientX,clientY){if(!S||S.done)return;const p=worldPoint(clientX,clientY);if(p.x<0||p.x>=W||p.y<0||p.y>=H)return;selectedCell={c:Math.floor(p.x/CELL),r:Math.floor(p.y/CELL)};render();if(answerDialog.showModal)answerDialog.showModal();else answerDialog.setAttribute('open','')}
map.addEventListener('pointerdown',e=>{map.setPointerCapture?.(e.pointerId);pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});clearHold();if(pointers.size===1){const sp=svgPoint(e.clientX,e.clientY);holdLast={x:e.clientX,y:e.clientY};gesture={type:'pending',id:e.pointerId,startClient:{x:e.clientX,y:e.clientY},startSvg:sp,startTx:camera.tx,startTy:camera.ty};holdTimer=setTimeout(()=>{if(gesture?.type==='pending'&&pointers.size===1){gesture.type='longpress';openSelectionAt(holdLast.x,holdLast.y)}},650)}else if(pointers.size===2){clearHold();const pts=[...pointers.values()],dx=pts[1].x-pts[0].x,dy=pts[1].y-pts[0].y,mid={x:(pts[0].x+pts[1].x)/2,y:(pts[0].y+pts[1].y)/2},m=svgPoint(mid.x,mid.y);gesture={type:'pinch',startDist:Math.hypot(dx,dy),startScale:camera.scale,anchorWorld:{x:(m.x-camera.tx)/camera.scale,y:(m.y-camera.ty)/camera.scale}}}});
map.addEventListener('pointermove',e=>{if(!pointers.has(e.pointerId))return;pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});holdLast={x:e.clientX,y:e.clientY};if(pointers.size===2){clearHold();const pts=[...pointers.values()],dx=pts[1].x-pts[0].x,dy=pts[1].y-pts[0].y,dist=Math.hypot(dx,dy),mid={x:(pts[0].x+pts[1].x)/2,y:(pts[0].y+pts[1].y)/2},m=svgPoint(mid.x,mid.y);if(gesture?.type!=='pinch')return;camera.scale=clamp(gesture.startScale*(dist/Math.max(1,gesture.startDist)),1,3.5);camera.tx=m.x-gesture.anchorWorld.x*camera.scale;camera.ty=m.y-gesture.anchorWorld.y*camera.scale;applyCamera();return}if(!gesture||gesture.id!==e.pointerId)return;const moved=Math.hypot(e.clientX-gesture.startClient.x,e.clientY-gesture.startClient.y);if(moved>9&&gesture.type==='pending'){clearHold();gesture.type='pan'}if(gesture.type==='pan'&&camera.scale>1){const now=svgPoint(e.clientX,e.clientY);camera.tx=gesture.startTx+(now.x-gesture.startSvg.x);camera.ty=gesture.startTy+(now.y-gesture.startSvg.y);applyCamera()}});
function endPointer(e){clearHold();pointers.delete(e.pointerId);if(pointers.size===0){gesture=null;holdLast=null}}map.addEventListener('pointerup',endPointer);map.addEventListener('pointercancel',endPointer);
function playTreasureSE(){const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;const ctx=new AC(),master=ctx.createGain();master.gain.value=.20;master.connect(ctx.destination);const now=ctx.currentTime;function tone(type,freq,t,dur,vol,fallTo){const o=ctx.createOscillator(),g=ctx.createGain();o.type=type;o.frequency.setValueAtTime(freq,t);if(fallTo)o.frequency.exponentialRampToValueAtTime(fallTo,t+dur*.7);g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(.001,t+dur);o.connect(g);g.connect(master);o.start(t);o.stop(t+dur+.02)}tone('square',170,now,.10,.17,80);tone('triangle',115,now+.09,.18,.10,68);[460,570,710,860].forEach((f,i)=>tone('triangle',f,now+.66+i*.045,.20,.10));[784,988,1175,1568].forEach((f,i)=>tone('sine',f,now+1.01+i*.08,.55,.075));setTimeout(()=>ctx.close().catch(()=>{}),2200)}function showTreasure(){treasureScore.textContent=S.score;treasureScene.classList.remove('play');void treasureScene.offsetWidth;if(treasureDialog.showModal)treasureDialog.showModal();else treasureDialog.setAttribute('open','');requestAnimationFrame(()=>treasureScene.classList.add('play'));playTreasureSE()}
confirmBtn.addEventListener('click',()=>{if(!S||!selectedCell)return;if(answerDialog.open)answerDialog.close();if(eq(selectedCell,S.target)){S.done=true;msg.textContent='宝を発見しました！';render();setTimeout(showTreasure,100)}else{S.wrong.add(key(selectedCell));S.score=Math.max(0,S.score-150);msg.textContent='そこにはありません。ヒントをもう一度確認しよう。';selectedCell=null;render()}});cancelBtn.addEventListener('click',()=>{if(answerDialog.open)answerDialog.close();selectedCell=null;render()});answerDialog.addEventListener('cancel',()=>{selectedCell=null;render()});backBtn.addEventListener('click',()=>{if(treasureDialog.open)treasureDialog.close()});nextTreasureBtn.addEventListener('click',()=>{if(treasureDialog.open)treasureDialog.close();start()});nextBtn.addEventListener('click',()=>{if(!S||S.done||S.shown>=S.hints.length)return;S.shown++;S.score=Math.max(100,S.score-140);msg.textContent=S.counts[S.shown-1]===1?'これですべてのヒントを満たす場所は1つです。':'新しいヒントが追加されました。';render()});zoomInBtn.addEventListener('click',()=>zoomAt(1.35));zoomOutBtn.addEventListener('click',()=>zoomAt(1/1.35));zoomResetBtn.addEventListener('click',()=>{camera={scale:1,tx:0,ty:0};applyCamera()});function start(){if(answerDialog.open)answerDialog.close();if(treasureDialog.open)treasureDialog.close();camera={scale:1,tx:0,ty:0};selectedCell=null;S=generate();if(!S){msg.textContent='問題生成に失敗しました。新しい地図を押してください。';return}msg.textContent='ヒントを読み、宝だと思う場所を長押ししてください。';render()}newBtn.addEventListener('click',start);drawLegend();start();
})();
